SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_/VITE_ prefix for this key.
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
MATEBREAK_LOCAL_ONLY=1

# Development defaults. Mock orders are ephemeral and never reserve stock.
SHIPPING_MODE=mock
PAYMENTS_MODE=mock
MOCK_PAYMENT_RESULT=approved
MOCK_ORIGIN_POSTAL_CODE=7000
# Optional local integration mode: reserves stock and persists mock-paid orders.
# Requires MATEBREAK_LOCAL_ONLY=1, localhost Supabase and both providers mock.
MATEBREAK_LOCAL_PERSIST_MOCK=0
# Fake agencies only; requires LOCAL_ONLY, localhost and both providers mock.
MATEBREAK_LOCAL_PICKUP_MOCK=0

# Required only with PAYMENTS_MODE=real and a public HTTPS APP_ORIGIN.
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_ENVIRONMENT=test
# Required explicit boolean for the approved account contract; do not infer
# live_mode from a Checkout Pro URL or token prefix. Confirm during homologation.
MP_EXPECTED_LIVE_MODE=
# Checkout Pro redirect does not currently use a public key.
MP_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Required only with SHIPPING_MODE=real. No public-site scraping.
# API credentials supplied by Correo Argentino for this environment.
# NOT the normal MiCorreo account email/password; customerId is separate.
CORREO_MICORREO_ENVIRONMENT=test
CORREO_MICORREO_USER=
CORREO_MICORREO_PASSWORD=
CORREO_MICORREO_CUSTOMER_ID=
CORREO_ORIGIN_POSTAL_CODE=
# Optional fallback for single products outside the mate/set packing policy.
# JSON: published product ID -> measured dimensions in g/cm.
CORREO_VERIFIED_PARCELS_JSON=

# Optional wholesale contact: one E.164 number, digits only. Empty disables submission.
# Configure only after approving the commercial destination; no automatic WhatsApp transport.
WHOLESALE_WHATSAPP_NUMBER=

# LOCAL candidate only: not connected to the web app or scheduled worker.
# Keep transport disabled until an independently authorized rollout.
EMAILS_ENABLED=0
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Backend AES-256-GCM envelope key: 32 random bytes as 64 lowercase hex digits.
# Generate/store in secret manager, never put an actual key in this file.
EMAIL_ENVELOPE_KEY=
